{% set pagetitle = 'Sign in'|trans %}
{% extends "@core/base.twig" %}

{% block postload %}
    {%- if recaptcha %}
    {# reCAPTCHA v3: the page must allow https://www.google.com and https://www.gstatic.com in its
       Content-Security-Policy (script-src, frame-src, connect-src); see the README. #}
    <script src="https://www.google.com/recaptcha/api.js?render={{ recaptcha.siteKey|url_encode }}" async defer></script>
    <script src="{{ asset('js/recaptcha.js', 'multiauthsinglepage') }}"></script>
    {%- endif %}
{% endblock %}

{% block content %}
    <h2>{{ pagetitle }}</h2>

    {%- if not isProduction %}
    <div class="message-box warning">
        {% trans %}You are now accessing a pre-production system. This authentication setup is for testing and pre-production verification only. If someone sent you a link that pointed you here, and you are not <i>a tester</i> you probably got the wrong link, and should <b>not be here</b>.{% endtrans %}
    </div>
    {% endif -%}

    {% if errorcode == 'MULTIAUTHTHROTTLED' -%}
    {# Shown only for the local LoginThrottle backoff (see LoginThrottle::ERROR_CODE), never for an
       accessControl-webservice block: that one must stay indistinguishable from a wrong password. No
       exact countdown or attempt count is shown here, to avoid handing an attacker precise timing to
       optimize automated retries against. #}
    <div class="message-box warning">
        <h3>{% trans %}Please wait a moment{% endtrans %}</h3>
        <p>{% trans %}We were not able to process this attempt right now. Please double-check that you
            are entering the correct username and password -- watch out for an accidental Caps Lock or
            the wrong keyboard layout -- and try again in a few seconds.{% endtrans %}</p>
    </div>
    {%- elseif errorcode == 'MULTIAUTHCAPTCHA' -%}
    <div class="message-box warning">
        <h3>{{ errorcodes['title'][errorcode]|trans }}</h3>
        <p>{{ errorcodes['descr'][errorcode]|trans }}
        {%- if recaptchaProblem == 'no-script' %}
            {% trans %}Your browser or network seems to be blocking Google reCAPTCHA, which is needed to sign in: allow it for this site (for example, in your ad or tracker blocker) or use another browser or network.{% endtrans %}
        {%- endif %}</p>
    </div>
    {%- elseif errorcode -%}
    <div class="message-box error">
        <h3>{{ errorcodes['title'][errorcode]|trans(errorparams) }}</h3>
        <p>{{ errorcodes['descr'][errorcode]|trans(errorparams) }}</p>
    </div>
    {%- endif %}

    {% for source in sources -%}
    <form action="" method="post" class="pure-form pure-form-stacked" name="f_{{ source.id }}"
        {%- if recaptcha and source.userpass %} data-recaptcha-sitekey="{{ recaptcha.siteKey }}" data-recaptcha-action="{{ recaptcha.action }}"{% endif %}>
        {% for key, value in stateParams -%}
        <input type="hidden" name="{{ key }}" value="{{ value }}">
        {% endfor -%}
        <input type="hidden" name="authsource" value="{{ source.id }}">

        <h3>{{ source.label|trans }}</h3>

        {% if source.userpass -%}
        <label for="username-{{ source.id }}">{{ 'Username'|trans }}</label>
        <input id="username-{{ source.id }}" type="text" name="username" autocomplete="username"
            {%- if username %} value="{{ username }}"{% endif %}>

        <label for="password-{{ source.id }}">{{ 'Password'|trans }}</label>
        <input id="password-{{ source.id }}" type="password" name="password" autocomplete="current-password">
        {% if recaptcha -%}
        <input type="hidden" name="g-recaptcha-response" value="">
        <input type="hidden" name="g-recaptcha-diag" value="">
        {% endif -%}
        {% endif -%}

        <button type="submit" class="pure-button pure-button-primary">{{ 'Sign in'|trans }}</button>
    </form>
    {%- else -%}
    <p>{{ 'No authentication sources have been configured.'|trans }}</p>
    {%- endfor %}
{% endblock %}
